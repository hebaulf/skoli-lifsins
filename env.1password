# Local development environment, resolved by the 1Password CLI at start-up:
#
#   pnpm dev:op        (= op run --env-file=env.1password -- pnpm dev)
#
# This file is committed. It must NEVER contain a secret value:
#   - secrets are op:// references into the 1Password vault "skoli-lifsins"
#   - non-secret settings are written as plain values
# No value may contain whitespace (the course Dokku server can't store it, and
# src/server/env.ts rejects it at startup).
# There is no plaintext .env file in this project.
#
# Lines for later phases are commented out until that phase: op run fails on a
# reference to an item that doesn't exist yet. Each phase uncomments its lines
# (docs/PLAN.md says which). tests/env-1password.test.ts checks that this file
# lists every variable in src/server/env.ts and that every secret is an op://
# reference.
#
# Demo (Dokku) values are set separately, see docs/PLAN.md section 4.

# --- Phase 1 ---
APP_BASE_URL=http://localhost:3000

# --- Phase 2: database ---
# DATABASE_URL=op://skoli-lifsins/Neon/dev-url

# --- Phase 3: auth + email ---
# BETTER_AUTH_SECRET=op://skoli-lifsins/BetterAuth/dev-secret
# RESEND_API_KEY=op://skoli-lifsins/Resend/dev-api-key
# EMAIL_FROM=onboarding@resend.dev

# --- Phase 5: Sanity ---
# SANITY_PROJECT_ID=<sanity-project-id>
# SANITY_DATASET=development
# SANITY_READ_TOKEN=op://skoli-lifsins/Sanity/dev-read-token

{
  "name": "skoli-lifsins",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:op": "op run --env-file=env.1password -- pnpm dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:set-app-password": "node scripts/db/set-app-password.mts",
    "db:check-grants": "node scripts/db/check-grants.mts",
    "prepare": "if [ -e .git ] && [ -z \"${CI:-}\" ]; then git config core.hooksPath .githooks; fi",
    "admin:create": "node scripts/admin/create-admin.mts",
    "check:ip-rate-limit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check/ip-rate-limit.mts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.25",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}

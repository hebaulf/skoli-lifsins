# Secrets: never in the build context, never in the image
.env
.env.*
# Local-dev 1Password reference file: no secrets, but not needed in the image
env.1password
*.pem
*.key

# VCS and tooling
.git
.github
.claude
.vscode
.idea

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Tests
tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.ts

# Source maps
**/*.map

# Docs and misc
docs
*.md
*.pdf
Dockerfile
.dockerignore
.DS_Store
npm-debug.log*
pnpm-debug.log*
